{
  "expo": {
    "name": "Life flow",
    "slug": "life-flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifeflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jameslporter.lifeflow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jameslporter.lifeflow"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6B5E"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.jameslporter.lifeflow",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Check off tasks for this part of the day.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/life-flow"
    }
  }
}
